# =====================================================================
# Variáveis de Ambiente - API de Catálogo de Produtos e Categorias
# Atividade Prática: Arquitetura e Desenvolvimento de APIs - UNINTER
# =====================================================================

# Chave secreta de autenticação para endpoints protegidos (Header: X-API-Key)
API_KEY=uninter_segredo_api_2026

# URL do banco de dados (SQLite persistente em arquivo local)
DATABASE_URL=sqlite:///./catalogo.db

# Configuração de CORS (lista de origens permitidas separadas por vírgula ou *)
CORS_ORIGINS=*

# Configuração de execução do servidor
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
